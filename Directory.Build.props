<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Suppress non-actionable duplicate-type and duplicate-attribute warnings that may arise
         from generated EF migration snapshots or multi-project compilation in this workspace. -->
    <NoWarn>0436;0579</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Disable SDK auto-generation of assembly attributes to avoid duplicate attribute errors
         when projects include manual assembly attributes or other tooling generates them. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Keep SDK-generated TargetFrameworkAttribute enabled. Disabling it can break tooling
         that expects project metadata. -->
  </PropertyGroup>
</Project>