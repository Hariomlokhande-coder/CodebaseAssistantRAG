@CodebaseAssistantRAG_HostAddress = http://localhost:5128
@RepositoryId = 00000000-0000-0000-0000-000000000000

POST {{CodebaseAssistantRAG_HostAddress}}/api/repository/upload
Content-Type: multipart/form-data; boundary=RepoBoundary

--RepoBoundary
Content-Disposition: form-data; name="file"; filename="repository.zip"
Content-Type: application/zip

< ./repository.zip
--RepoBoundary--

###

POST {{CodebaseAssistantRAG_HostAddress}}/api/repository/index/{{RepositoryId}}

###

POST {{CodebaseAssistantRAG_HostAddress}}/api/search
Content-Type: application/json

{
  "repositoryId": "{{RepositoryId}}",
  "query": "Where is authentication configured?",
  "topK": 5
}

###

POST {{CodebaseAssistantRAG_HostAddress}}/api/chat/query
Content-Type: application/json

{
  "repositoryId": "{{RepositoryId}}",
  "question": "Explain the main request flow.",
  "topK": 5
}
